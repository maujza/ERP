# Storefront environment — copy to .env and fill in the required values.
# NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY and NEXT_PUBLIC_MEDUSA_REGION_ID are
# auto-filled by scripts/sync-medusa-env.sh after the backend is running.

# ── Medusa connection ─────────────────────────────────────────────────────────
# Public URL of the Medusa backend (used by the browser).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Server-side only: used by Next.js API proxy rewrite (not exposed to browser).
MEDUSA_INTERNAL_BACKEND_URL=http://localhost:9000

# ── Synced automatically by scripts/sync-medusa-env.sh ───────────────────────
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_REGION_ID=
NEXT_PUBLIC_MEDUSA_COUNTRY_CODE=ar

# ── Store config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHIPPING_STANDARD_ARS=3900
NEXT_PUBLIC_SHIPPING_EXPRESS_ARS=7200

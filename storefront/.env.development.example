# Storefront dev overrides — copy to .env.development for local development.
# Next.js loads this automatically when NODE_ENV=development (npm run dev).
# Gitignored — never commit actual values.

# ── Medusa connection ─────────────────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_INTERNAL_BACKEND_URL=http://localhost:9000

# ── Synced automatically by scripts/sync-medusa-env.sh ───────────────────────
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_MEDUSA_REGION_ID=
NEXT_PUBLIC_MEDUSA_COUNTRY_CODE=ar

# ── Store config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SHIPPING_STANDARD_ARS=3900
NEXT_PUBLIC_SHIPPING_EXPRESS_ARS=7200

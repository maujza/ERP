# Storefront env for Next.js.
# The storefront now talks to Medusa through the internal Next proxy `/api/medusa`,
# so no public backend URL is required here.

NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_change_me
NEXT_PUBLIC_MEDUSA_REGION_ID=reg_change_me
NEXT_PUBLIC_MEDUSA_COUNTRY_CODE=ar
NEXT_PUBLIC_WHATSAPP_NUMBER=5491100000000
NEXT_PUBLIC_SHIPPING_STANDARD_ARS=3900
NEXT_PUBLIC_SHIPPING_EXPRESS_ARS=7200

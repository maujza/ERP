# Backend dev overrides — copy to .env.dev for local development.
# These values override .env when running: npm run dev
# Gitignored — never commit actual values.

# ── Database ──────────────────────────────────────────────────────────────────
# Docker DB is exposed on 5433 locally
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev origins only
STORE_CORS=http://localhost:3000,http://localhost:7358,http://127.0.0.1:7358
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:7358,http://127.0.0.1:7358,http://localhost:9000

# ── Secrets ───────────────────────────────────────────────────────────────────
MEDUSA_FORCE_INSECURE_COOKIES=true
MEDUSA_ADMIN_URL=http://localhost:9000

# ── Seed ──────────────────────────────────────────────────────────────────────
SEED_DEMO_DATA=false

# Backend TEST environment — copy to .env.test for running integration tests.
# Loaded by jest.config.js via loadEnv("test"), layered on top of .env.
#
# @medusajs/test-utils creates/drops a temporary database per run using pg-god,
# which reads the split DB_* vars below (NOT DATABASE_URL). They must point at the
# same Postgres server as DATABASE_URL — the Docker `db` service on host port 5433.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=medusa
DB_PASSWORD=medusa

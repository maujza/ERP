# Backend environment — copy to .env and fill in the required values.
# JWT_SECRET, COOKIE_SECRET, DATABASE_URL, and MEDUSA_ADMIN_PASSWORD are REQUIRED.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://medusa:medusa@localhost:5433/medusa

# ── CORS ──────────────────────────────────────────────────────────────────────
# Add all origins that need to talk to the backend, comma-separated.
STORE_CORS=http://localhost:7358,http://127.0.0.1:7358
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:7358,http://127.0.0.1:7358,http://localhost:9000

# ── Secrets ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
MEDUSA_FORCE_INSECURE_COOKIES=true
MEDUSA_ADMIN_EMAIL=admin@aurelia.com
MEDUSA_ADMIN_PASSWORD=change-me-in-production
MEDUSA_ADMIN_URL=http://localhost:9000

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Verify a sending domain in Resend first, then create an API key.
RESEND_API_KEY=
RESEND_FROM=Aurelia <invitaciones@mail.aurelia.gleeze.com>

# ── Cloudflare R2 (file storage) ──────────────────────────────────────────────
# Used for product image uploads. Images >500KB or >1400px are auto-converted
# to WebP (quality 82). Non-image uploads are rejected.
# 1. Create a bucket in Cloudflare R2
# 2. Create an API token with Object Read & Write permissions
# 3. Enable "Public Development URL" on the bucket (Settings → Public Access)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Seed ──────────────────────────────────────────────────────────────────────
# Set to true to seed the demo jewelry catalog on startup (idempotent).
SEED_DEMO_DATA=false

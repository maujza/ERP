{
  "name": "aurelia-backend",
  "version": "0.0.1",
  "description": "Aurelia – bijouterie mayorista Argentina, backend Medusa 2.x.",
  "author": "Aurelia",
  "license": "MIT",
  "keywords": [
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "argentina",
    "aurelia"
  ],
  "scripts": {
    "build": "node ./scripts/patch-dashboard-i18n.mjs && medusa build && node ./scripts/patch-admin-branding.mjs",
    "postinstall": "node ./scripts/patch-dashboard-i18n.mjs",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:aurelia": "medusa exec ./src/scripts/seed-aurelia.ts",
    "seed:e2e": "medusa exec ./src/scripts/seed-e2e.ts",
    "cleanup:e2e": "medusa exec ./src/scripts/cleanup-e2e.ts",
    "start": "medusa start",
    "dev": "sh -c 'set -a; [ -f .env ] && . ./.env; [ -f .env.dev ] && . ./.env.dev; set +a; exec medusa develop'",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.782.0",
    "@medusajs/admin-sdk": "2.13.1",
    "@medusajs/cli": "2.13.1",
    "@medusajs/framework": "2.13.1",
    "@medusajs/medusa": "2.13.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.13.1",
    "@playwright/test": "^1.60.0",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.14"
  },
  "engines": {
    "node": ">=20"
  }
}

# Docker Compose variables used by infrastructure services.
# Copy this file to .env on the deployment host and replace the value.
NGINX_DB_PASSWORD=replace-with-a-long-random-password
MONITORING_ADMIN_USER=replace-with-an-admin-user
MONITORING_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbB admin '<password>' | cut -d: -f2
PORTAINER_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

# Grafana alert notifications, routed through Resend's SMTP relay (see
# infra/monitoring/configs/grafana/provisioning/alerting/contact-points.yml).
# Same Resend account as backend/.env, but kept as its own copy here since
# this stack reads infra/.env, not backend/.env.
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM=ERP Monitoring <alerts@mail.aurelia.gleeze.com>
# Bare address only, no display name — Grafana's GF_SMTP_FROM_ADDRESS
# rejects the "Display Name <email>" form RESEND_FROM uses (the display
# name is supplied separately via GF_SMTP_FROM_NAME in compose.yml).
RESEND_FROM_EMAIL=alerts@mail.aurelia.gleeze.com
# Multiple recipients: separate with ";" or a newline.
MONITORING_ALERT_EMAIL=replace-with-alert-recipient@example.com

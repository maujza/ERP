# Copy to vault.yml, fill in real values, then encrypt in place:
#   ansible-vault encrypt group_vars/all/vault.yml
# vault.yml is gitignored. Commit only the ENCRYPTED file if you want it in git
# (git add -f group_vars/all/vault.yml), and store the vault password in a manager.

vault_jwt_secret: "REPLACE_WITH_32_BYTE_HEX"
vault_cookie_secret: "REPLACE_WITH_32_BYTE_HEX"
vault_medusa_admin_password: "REPLACE_WITH_ADMIN_PASSWORD"

# Read-only deploy key (private) registered on aikirias/ERP -> Settings -> Deploy keys
vault_github_deploy_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  REPLACE_WITH_PRIVATE_KEY
  -----END OPENSSH PRIVATE KEY-----

# Resend (optional)
vault_resend_api_key: ""
vault_resend_from: "Aurelia <invitaciones@mail.aurelia.gleeze.com>"

# Cloudflare R2 (optional — blank disables image uploads)
vault_r2_account_id: ""
vault_r2_access_key_id: ""
vault_r2_secret_access_key: ""
vault_r2_bucket: ""
vault_r2_endpoint: ""
vault_r2_public_url: ""

# Off-site DB backups: WireGuard tunnel from the VPS into the operator's home
# LAN (see deploy/ansible/README.md and docs/db-restore-runbook.md) — split
# tunnel only, never routes 0.0.0.0/0 through it. Generated by adding the VPS
# as a peer in the home WireGuard server's admin panel (e.g. wg-easy).
vault_wg_vps_private_key: ""
vault_wg_home_peer_public_key: ""
vault_wg_preshared_key: ""
vault_wg_endpoint: "REPLACE_WITH_HOST:PORT"

# NAS rsync daemon account (Synology DSM: File Services -> rsync -> Enable
# rsync account) — not an SSH key, because this NAS (like most Synology
# defaults) restricts SSH/terminal login to the administrators group with no
# per-user override. The rsync daemon account is Synology's own supported
# path for non-admin external clients. Traffic only ever reaches the NAS
# through the WireGuard tunnel above, never over the public internet, so the
# protocol's own lack of transport encryption is covered by that lower layer.
vault_nas_backup_rsync_password: ""

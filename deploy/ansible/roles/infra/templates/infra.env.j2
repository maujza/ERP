NGINX_DB_PASSWORD={{ vault_nginx_db_password }}
MONITORING_ADMIN_USER={{ monitoring_admin_user }}
MONITORING_ADMIN_PASSWORD={{ vault_monitoring_admin_password }}
PORTAINER_ADMIN_PASSWORD_HASH={{ vault_portainer_admin_password_hash }}

RESEND_API_KEY={{ vault_resend_api_key | default('') }}
RESEND_FROM={{ vault_resend_from | default('') }}
{# Grafana's GF_SMTP_FROM_ADDRESS rejects the "Display Name <email>" form
   that RESEND_FROM uses everywhere else (Resend's HTTP API, backend.env.j2,
   send-resend-mail.sh) — it wants the bare address only and refuses to boot
   otherwise ("invalid email address for SMTP from_address config"), the
   display name is supplied separately via GF_SMTP_FROM_NAME. Derived here
   instead of asking the operator to keep a second vault value in sync. #}
RESEND_FROM_EMAIL={{ vault_resend_from | default('') | regex_replace('^.*<(.+)>.*$', '\\1') }}
{# Grafana's email contact point wants ";"-separated addresses; vars.yml
   keeps the same comma-separated convention as backup_alert_email so the
   operator doesn't have to remember two formats. #}
MONITORING_ALERT_EMAIL={{ monitoring_alert_email | replace(',', ';') }}

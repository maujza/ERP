# Docker Compose variables used by infrastructure services.
# Copy this file to .env on the deployment host and replace the value.
NGINX_DB_PASSWORD=replace-with-a-long-random-password
MONITORING_ADMIN_USER=replace-with-an-admin-user
MONITORING_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbB admin '<password>' | cut -d: -f2
PORTAINER_ADMIN_PASSWORD_HASH=replace-with-a-bcrypt-hash

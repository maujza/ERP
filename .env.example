# Docker Compose environment — copy to .env and fill in values.
# JWT_SECRET, COOKIE_SECRET, and MEDUSA_ADMIN_PASSWORD are REQUIRED (no defaults).

# ── Public domains ────────────────────────────────────────────────────────────
# Used to build CORS allowlists and invite email links.
# Add all origins that need to talk to the backend, comma-separated.
STORE_CORS=http://localhost:7358,http://127.0.0.1:7358,http://localhost:8081,http://127.0.0.1:8081,http://localhost:9000,http://127.0.0.1:9000,http://pione:7358,http://pione:8081,http://pione:9000,https://aurelia.gleeze.com,https://pos.aurelia.gleeze.com
ADMIN_CORS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:9000,http://127.0.0.1:9000,http://pione:8081,http://pione:9000,https://backoffice.aurelia.gleeze.com,https://pos.aurelia.gleeze.com
AUTH_CORS=http://localhost:7358,http://127.0.0.1:7358,http://localhost:8081,http://127.0.0.1:8081,http://localhost:9000,http://127.0.0.1:9000,http://pione:7358,http://pione:8081,http://pione:9000,https://aurelia.gleeze.com,https://backoffice.aurelia.gleeze.com,https://pos.aurelia.gleeze.com

# ── Backend URL (used in invite email links) ──────────────────────────────────
MEDUSA_ADMIN_URL=https://backoffice.aurelia.gleeze.com

# ── Secrets ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
COOKIE_SECRET=change-me-in-production
MEDUSA_FORCE_INSECURE_COOKIES=false
MEDUSA_ADMIN_EMAIL=admin@aurelia.com
MEDUSA_ADMIN_PASSWORD=change-me-in-production

# ── Resend ────────────────────────────────────────────────────────────────────
# Used for backoffice invitation emails.
# Verify a sending domain in Resend first (recommended: mail.aurelia.gleeze.com)
RESEND_API_KEY=
RESEND_FROM=Aurelia <invitaciones@mail.aurelia.gleeze.com>

# ── Legacy fallback (optional) ───────────────────────────────────────────────
# Only needed if you want to keep the old SendGrid notification fallback.
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@aurelia.com
